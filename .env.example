# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=disabled
DEEPSEEK_REASONING_EFFORT=low
LLM_TEMPERATURE=0.2
LLM_TOP_P=1.0
LLM_MAX_TOKENS=1800
LLM_TIMEOUT_SECONDS=90

# PageIndex
PAGEINDEX_API_KEY=
PAGEINDEX_BASE_URL=https://api.pageindex.ai
PAGEINDEX_ENABLED=true
PAGEINDEX_POLL_INTERVAL_SECONDS=3
PAGEINDEX_PROCESSING_TIMEOUT_SECONDS=300
PAGEINDEX_RETRIEVAL_TIMEOUT_SECONDS=120

# Existing local embedding
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=BAAI/bge-m3
CHROMA_COLLECTION=ielts_writing_docs
HF_TOKEN=
HF_HOME=.cache/huggingface
TRANSFORMERS_CACHE=.cache/huggingface

# Retrieval
RETRIEVAL_MODE=hybrid
SCORE_THRESHOLD=0.51
TOP_K=5

# Optional Qwen visual preprocessing
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=qwen3.7-flash
QWEN_VISION_ENABLED=false
